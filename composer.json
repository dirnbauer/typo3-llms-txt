{
    "name": "webconsulting/typo3-llms-txt",
    "type": "typo3-cms-extension",
    "description": "Serves /llms.txt and /agents.md per TYPO3 site, generated from the page tree and site configuration — deliberate publishing for the agent-readable web.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "typo3",
        "llms.txt",
        "agents.md",
        "ai",
        "agents",
        "aeo"
    ],
    "homepage": "https://github.com/dirnbauer/typo3-llms-txt",
    "authors": [
        {
            "name": "Kurt Dirnbauer",
            "email": "dirnbauer@webconsulting.at",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-llms-txt/issues",
        "source": "https://github.com/dirnbauer/typo3-llms-txt",
        "docs": "https://github.com/dirnbauer/typo3-llms-txt/tree/main/Documentation"
    },
    "require": {
        "php": "^8.4",
        "symfony/console": "^7.4",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-frontend": "^14.3.7",
        "typo3/cms-seo": "^14.3.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.4 || ^13.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.5",
        "webconsulting/typo3-abilities": "^1.2"
    },
    "suggest": {
        "hn/typo3-mcp-server": "agents.md advertises the MCP endpoint and its ability_* tools when installed",
        "webconsulting/typo3-abilities": "^1.0 || ^1.1 || ^1.2 — agents.md lists the registered abilities and the REST/CLI projections when installed; the catalogue line needs 1.2"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\LlmsTxt\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\LlmsTxt\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "llms_txt",
            "version": "1.2.0",
            "web-dir": ".Build/public",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "scripts": {
        "ci": [
            "@ci:cgl",
            "@ci:phpstan",
            "@ci:tests:unit",
            "@ci:tests:functional"
        ],
        "ci:cgl": "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose",
        "ci:phpstan": "phpstan analyse --configuration phpstan.neon --no-progress",
        "ci:tests:functional": "phpunit --configuration Build/phpunit/FunctionalTests.xml",
        "ci:tests:unit": "phpunit --configuration Build/phpunit/UnitTests.xml"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-abilities"
        }
    ]
}
